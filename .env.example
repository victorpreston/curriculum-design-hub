NODE_ENV=development
PORT=4000

POSTGRES_USER=hub
POSTGRES_PASSWORD=hub_local_only
POSTGRES_DB=curriculum_hub
POSTGRES_PORT=5433
DATABASE_URL=postgres://hub:hub_local_only@localhost:5433/curriculum_hub
TEST_DATABASE_URL=postgres://hub:hub_local_only@localhost:5433/curriculum_hub_test

JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

LLM_PROVIDER=mock
MOCK_LLM_SCENARIO=ok
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
LLM_TIMEOUT_MS=90000
GENERATIONS_PER_HOUR=30

EMBEDDING_PROVIDER=local
